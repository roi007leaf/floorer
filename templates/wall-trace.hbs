<div class="floorer-wall-trace-body">
  <p class="hint">{{localize "FLOORER.WallTrace.Hint"}}</p>
  <div class="field">
    <label for="{{id}}-threshold" data-tooltip="{{localize 'FLOORER.WallTrace.Tip.Threshold'}}">{{localize "FLOORER.WallTrace.Threshold"}}</label>
    <input type="range" id="{{id}}-threshold" name="threshold" min="0.05" max="0.6" step="0.01" value="{{threshold}}">
    <output name="threshold">{{threshold}}</output>
  </div>
  <div class="field">
    <label for="{{id}}-minSquares" data-tooltip="{{localize 'FLOORER.WallTrace.Tip.MinLength'}}">{{localize "FLOORER.WallTrace.MinLength"}}</label>
    <input type="range" id="{{id}}-minSquares" name="minSquares" min="0.1" max="3" step="0.1" value="{{minSquares}}">
    <output name="minSquares">{{minSquares}}</output>
  </div>
  <p class="count">{{#if loading}}{{localize "FLOORER.WallTrace.Loading"}}{{else}}{{localize "FLOORER.WallTrace.Count" count=count}}{{/if}}</p>
  <footer class="form-footer">
    <button type="button" data-action="cancel">{{localize "FLOORER.Common.Cancel"}}</button>
    <button type="button" class="primary" data-action="apply" {{#unless count}}disabled{{/unless}}><i class="fas fa-check"></i>{{localize "FLOORER.WallTrace.Apply"}}</button>
  </footer>
</div>
