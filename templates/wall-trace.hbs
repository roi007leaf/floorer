<div class="floorer-wall-trace-body">
  <p class="hint">{{localize "FLOORER.WallTrace.Hint"}}</p>
  <div class="fields">
    <label for="{{id}}-edgeStrength" data-tooltip="{{localize 'FLOORER.WallTrace.Tip.EdgeStrength'}}">{{localize "FLOORER.WallTrace.EdgeStrength"}}</label>
    <input type="range" id="{{id}}-edgeStrength" name="edgeStrength" min="0.1" max="0.8" step="0.01" value="{{edgeStrength}}">
    <output name="edgeStrength" for="{{id}}-edgeStrength">{{edgeStrength}}</output>
    <label for="{{id}}-minSquares" data-tooltip="{{localize 'FLOORER.WallTrace.Tip.MinLength'}}">{{localize "FLOORER.WallTrace.MinLength"}}</label>
    <input type="range" id="{{id}}-minSquares" name="minSquares" min="0.5" max="6" step="0.5" value="{{minSquares}}">
    <output name="minSquares" for="{{id}}-minSquares">{{minSquares}}</output>
  </div>
  <div class="status">
    <span class="chip info count">{{#if loading}}{{localize "FLOORER.WallTrace.Loading"}}{{else}}{{localize "FLOORER.WallTrace.Count" count=count}}{{/if}}</span>
  </div>
  <footer class="form-footer">
    <button type="button" data-action="cancel">{{localize "FLOORER.Common.Cancel"}}</button>
    <button type="button" class="primary" data-action="apply" {{#unless count}}disabled{{/unless}}><i class="fas fa-check"></i>{{localize "FLOORER.WallTrace.Apply"}}</button>
  </footer>
</div>
