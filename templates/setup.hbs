<div class="form-group">
  <label>{{localize "FLOORER.Setup.FloorsAbove"}}</label>
  <input type="number" name="floorsAbove" min="0" step="1" value="{{floorsAbove}}">
</div>
<div class="form-group">
  <label>{{localize "FLOORER.Setup.Basements"}}</label>
  <input type="number" name="basements" min="0" step="1" value="{{basements}}">
</div>
<div class="form-group">
  <label>{{localize "FLOORER.Setup.Roof"}}</label>
  <input type="checkbox" name="roof" {{#if roof}}checked{{/if}}>
</div>
<div class="form-group">
  <label>{{localize "FLOORER.Setup.FloorHeight"}}</label>
  <input type="number" name="floorHeight" min="1" step="any" value="{{floorHeight}}">
</div>
<div class="form-group">
  <label>{{localize "FLOORER.Setup.GroundBottom"}}</label>
  <input type="number" name="groundBottom" step="any" value="{{groundBottom}}">
</div>
<div class="form-group stacked">
  <label>{{localize "FLOORER.Setup.Images"}}</label>
  <p class="hint">{{localize "FLOORER.Setup.ImagesHint"}}</p>
  <textarea name="images" rows="5">{{images}}</textarea>
  <button type="button" data-action="pickImages"><i class="fas fa-file-image"></i> {{localize "FLOORER.Setup.AddImage"}}</button>
</div>
<footer class="form-footer">
  <button type="submit"><i class="fas fa-layer-group"></i> {{localize "FLOORER.Setup.Submit"}}</button>
</footer>
