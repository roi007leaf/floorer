<section class="floorer-body">
<header class="floorer-head">
  <span class="scene" data-tooltip="{{sceneName}}">{{sceneName}}</span>
  <div class="toolbar">
    <button type="button" class="icon" data-action="setup" data-tooltip="{{localize 'FLOORER.Panel.Setup'}}"><i class="fas fa-layer-group"></i></button>
    <button type="button" class="icon {{#if isolationEnabled}}active{{/if}}" data-action="toggleIsolation" data-tooltip="{{localize 'FLOORER.Panel.DimOthers'}}"><i class="fas fa-eye-low-vision"></i></button>
    <button type="button" class="icon" data-action="undo" data-tooltip="{{localize 'FLOORER.Panel.Undo'}}" {{#unless journalSize}}disabled{{/unless}}><i class="fas fa-undo"></i></button>
    <button type="button" class="icon" data-action="revert" data-tooltip="{{localize 'FLOORER.Panel.Revert'}}" {{#unless journalSize}}disabled{{/unless}}><i class="fas fa-history"></i>{{#if journalSize}}<span class="badge">{{journalSize}}</span>{{/if}}</button>
  </div>
</header>

{{#if intent}}
<div class="floorer-intent">
  <i class="fas fa-pencil"></i>
  <span class="text">{{localize (concat "FLOORER.Intent.Armed." intent.kind) level=intent.levelName}}</span>
  <button type="button" class="icon" data-action="cancelIntent" data-tooltip="{{localize 'FLOORER.Common.Cancel'}}"><i class="fas fa-xmark"></i></button>
</div>
{{/if}}

<ol class="floorer-levels">
{{#each rows}}
  <li class="level {{#if active}}active{{/if}} {{#if managed}}managed{{else}}unmanaged{{/if}}" data-level-id="{{id}}">
    <div class="row-head">
      <span class="caret" data-action="activate" data-level-id="{{id}}"><i class="fas {{#if active}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i></span>
      <span class="rail">{{band}}</span>
      <span class="name" data-action="activate" data-level-id="{{id}}" data-name="{{name}}">{{name}}</span>
      {{#if managed}}<button type="button" class="icon rename" data-action="rename" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Rename'}}"><i class="fas fa-pen"></i></button>{{/if}}
      <span class="spacer"></span>
      <span class="chips">
        {{#if hasSurface}}<span class="chip success" data-tooltip="{{localize 'FLOORER.Panel.HasSurface'}}"><i class="fas fa-check"></i></span>{{else}}<span class="chip muted" data-tooltip="{{localize 'FLOORER.Panel.NoSurface'}}"><i class="fas fa-xmark"></i></span>{{/if}}
        {{#if holeCount}}<span class="chip" data-tooltip="{{localize 'FLOORER.Panel.Holes'}}"><i class="fas fa-circle-minus"></i>{{holeCount}}</span>{{/if}}
        {{#if stairCount}}<span class="chip" data-tooltip="{{localize 'FLOORER.Panel.StairLinks' levels=stairLinks}}{{#if openingCount}} · {{localize 'FLOORER.Panel.StairOpenings' count=openingCount}}{{/if}}"><i class="fas fa-stairs"></i>{{stairCount}}</span>{{/if}}
        {{#if sealed}}<span class="chip info" data-tooltip="{{localize 'FLOORER.Panel.Sealed'}}"><i class="fas fa-lock"></i></span>{{/if}}
        {{#unless managed}}<button type="button" class="chip dashed" data-action="adopt" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.AdoptHint'}}"><i class="fas fa-hand"></i>{{localize "FLOORER.Panel.Adopt"}}</button>{{/unless}}
      </span>
    </div>
    {{#if active}}{{#if managed}}
    <div class="row-tools">
      <div class="group">
        <span class="group-label">{{localize "FLOORER.Panel.Footprint"}}</span>
        <button type="button" class="icon" data-action="drawFootprint" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.DrawPolygon'}}"><i class="fas fa-draw-polygon"></i></button>
        <button type="button" class="icon" data-action="drawRect" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.DrawRect'}}"><i class="fas fa-vector-square"></i></button>
        <button type="button" class="icon" data-action="wholeScene" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.WholeScene'}}"><i class="fas fa-expand"></i></button>
      </div>
      <div class="group">
        <span class="group-label">{{localize "FLOORER.Panel.Hole"}}</span>
        <button type="button" class="icon" data-action="drawHole" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.DrawHole'}}"><i class="fas fa-circle-minus"></i></button>
      </div>
      <div class="group">
        <span class="group-label">{{localize "FLOORER.Panel.Stair"}}</span>
        <select name="target-{{id}}" data-tooltip="{{localize 'FLOORER.Panel.StairTarget'}}">
          {{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
        <button type="button" class="icon" data-action="drawStair" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.DrawStair'}}"><i class="fas fa-stairs"></i></button>
      </div>
    </div>
    {{/if}}{{/if}}
    {{#if issues.length}}
    <div class="row-issues">
      {{#each issues}}
      <span class="chip warning" data-tooltip="{{localize label levels=levels}}">
        <i class="fas fa-triangle-exclamation"></i>{{localize label levels=levels}}
        {{#if fixable}}<button type="button" class="icon fix" data-action="fix" data-issue-key="{{key}}" data-tooltip="{{localize 'FLOORER.Panel.Fix'}}"><i class="fas fa-wand-magic-sparkles"></i></button>{{/if}}
      </span>
      {{/each}}
    </div>
    {{/if}}
  </li>
{{/each}}
</ol>

<footer class="floorer-foot">
  {{#if issueCount}}
    <span class="status warning"><i class="fas fa-triangle-exclamation"></i>{{localize "FLOORER.Panel.IssueCount" count=issueCount}}</span>
  {{else}}
    <span class="status success"><i class="fas fa-circle"></i>{{localize "FLOORER.Panel.NoIssues"}}</span>
  {{/if}}
  {{#if autoFixCount}}
    <button type="button" class="fix-all" data-action="fixAll"><i class="fas fa-wand-magic-sparkles"></i>{{localize "FLOORER.Panel.FixAll"}}<span class="count">{{autoFixCount}}</span></button>
  {{/if}}
</footer>
</section>
