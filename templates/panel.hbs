<section class="floorer-body">
<header class="floorer-head">
  <span class="scene">{{sceneName}}</span>
  <div class="toolbar">
    <button type="button" class="icon" data-action="setup" title="{{localize 'FLOORER.Panel.Setup'}}"><i class="fas fa-layer-group"></i></button>
    <button type="button" class="icon {{#if isolationEnabled}}active{{/if}}" data-action="toggleIsolation" title="{{localize 'FLOORER.Panel.DimOthers'}}"><i class="fas fa-eye-low-vision"></i></button>
    <button type="button" class="icon" data-action="undo" title="{{localize 'FLOORER.Panel.Undo'}}" {{#unless journalSize}}disabled{{/unless}}><i class="fas fa-undo"></i></button>
    <button type="button" class="icon" data-action="revert" title="{{localize 'FLOORER.Panel.Revert'}}" {{#unless journalSize}}disabled{{/unless}}><i class="fas fa-history"></i>{{#if journalSize}}<span class="badge">{{journalSize}}</span>{{/if}}</button>
  </div>
</header>

{{#if intent}}
<div class="floorer-intent">
  <i class="fas fa-pencil"></i>
  <span class="text">{{localize (concat "FLOORER.Intent.Armed." intent.kind) level=intent.levelName}}</span>
  <button type="button" data-action="cancelIntent">{{localize "FLOORER.Common.Cancel"}}</button>
</div>
{{/if}}

<ol class="floorer-levels">
{{#each rows}}
  <li class="level {{#if active}}active{{/if}} {{#if managed}}managed{{else}}unmanaged{{/if}}" data-level-id="{{id}}">
    <div class="row-head">
      <span class="rail">{{band}}</span>
      <span class="caret" data-action="activate" data-level-id="{{id}}"><i class="fas {{#if active}}fa-caret-down{{else}}fa-caret-right{{/if}}"></i></span>
      <span class="name" data-action="activate" data-level-id="{{id}}" data-name="{{name}}">{{name}}</span>
      {{#if managed}}<button type="button" class="icon rename" data-action="rename" data-level-id="{{id}}" title="{{localize 'FLOORER.Panel.Rename'}}"><i class="fas fa-pen"></i></button>{{/if}}
      <span class="chips">
        {{#if hasSurface}}<span class="chip ok" title="{{localize 'FLOORER.Panel.HasSurface'}}"><i class="fas fa-square-check"></i></span>{{else}}<span class="chip muted" title="{{localize 'FLOORER.Panel.NoSurface'}}"><i class="fas fa-square"></i> {{localize "FLOORER.Panel.NoSurface"}}</span>{{/if}}
        {{#if holeCount}}<span class="chip" title="{{localize 'FLOORER.Panel.Holes'}}"><i class="fas fa-circle-minus"></i> {{holeCount}}</span>{{/if}}
        {{#if stairCount}}<span class="chip" title="{{localize 'FLOORER.Panel.Stairs'}}"><i class="fas fa-stairs"></i> {{stairCount}}</span>{{/if}}
        {{#if sealed}}<span class="chip" title="{{localize 'FLOORER.Panel.Sealed'}}"><i class="fas fa-lock"></i></span>{{/if}}
        {{#unless managed}}<button type="button" class="chip action" data-action="adopt" data-level-id="{{id}}" title="{{localize 'FLOORER.Panel.AdoptHint'}}"><i class="fas fa-hand"></i> {{localize "FLOORER.Panel.Adopt"}}</button>{{/unless}}
      </span>
    </div>
    {{#if issues.length}}
    <ul class="issues">
      {{#each issues}}
      <li class="issue">
        <i class="fas fa-triangle-exclamation"></i>
        <span class="label">{{localize label}}</span>
        {{#if fixable}}<button type="button" data-action="fix" data-issue-key="{{key}}">{{localize "FLOORER.Panel.Fix"}}</button>{{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if active}}{{#if managed}}
    <div class="row-body">
      <div class="group">
        <span class="group-label">{{localize "FLOORER.Panel.Footprint"}}</span>
        <button type="button" class="icon" data-action="drawFootprint" data-level-id="{{id}}" title="{{localize 'FLOORER.Panel.DrawPolygon'}}"><i class="fas fa-draw-polygon"></i></button>
        <button type="button" class="icon" data-action="drawRect" data-level-id="{{id}}" title="{{localize 'FLOORER.Panel.DrawRect'}}"><i class="fas fa-vector-square"></i></button>
        <button type="button" class="icon" data-action="wholeScene" data-level-id="{{id}}" title="{{localize 'FLOORER.Panel.WholeScene'}}"><i class="fas fa-expand"></i></button>
      </div>
      <div class="group">
        <span class="group-label">{{localize "FLOORER.Panel.Hole"}}</span>
        <button type="button" class="icon" data-action="drawHole" data-level-id="{{id}}" title="{{localize 'FLOORER.Panel.DrawHole'}}"><i class="fas fa-circle-minus"></i></button>
      </div>
      <div class="group">
        <span class="group-label">{{localize "FLOORER.Panel.Stair"}}</span>
        <select name="target-{{id}}" title="{{localize 'FLOORER.Panel.StairTarget'}}">
          {{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
        <button type="button" class="icon" data-action="drawStair" data-level-id="{{id}}" title="{{localize 'FLOORER.Panel.DrawStair'}}"><i class="fas fa-stairs"></i></button>
      </div>
    </div>
    {{/if}}{{/if}}
  </li>
{{/each}}
</ol>

<footer class="floorer-foot">
  {{#if autoFixCount}}
    <button type="button" data-action="fixAll"><i class="fas fa-wand-magic-sparkles"></i> {{localize "FLOORER.Panel.FixAll"}} ({{autoFixCount}})</button>
  {{else if issueCount}}
    <span class="status warn"><i class="fas fa-triangle-exclamation"></i> {{localize "FLOORER.Panel.IssueCount" count=issueCount}}</span>
  {{else}}
    <span class="status ok"><i class="fas fa-check"></i> {{localize "FLOORER.Panel.NoIssues"}}</span>
  {{/if}}
</footer>
</section>
