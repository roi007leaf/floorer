<section class="floorer-body">
<header class="floorer-head">
  <span class="scene" data-tooltip="{{sceneName}}">{{sceneName}}</span>
  <div class="toolbar">
    <button type="button" class="icon" data-action="setup" data-tooltip="{{localize 'FLOORER.Panel.Setup'}}"><i class="fas fa-layer-group"></i></button>
    <span class="icon help" data-tooltip="{{localize 'FLOORER.Panel.Help'}}"><i class="fas fa-circle-question"></i></span>
    <button type="button" class="icon" data-action="undo" data-tooltip="{{localize 'FLOORER.Panel.Undo'}}" {{#unless journalSize}}disabled{{/unless}}><i class="fas fa-undo"></i></button>
    <button type="button" class="icon" data-action="revert" data-tooltip="{{localize 'FLOORER.Panel.Revert'}}" {{#unless journalSize}}disabled{{/unless}}><i class="fas fa-history"></i>{{#if journalSize}}<span class="badge">{{journalSize}}</span>{{/if}}</button>
  </div>
</header>

{{#if intent}}
<div class="floorer-intent">
  <i class="fas fa-pencil"></i>
  <span class="text">{{localize (concat "FLOORER.Intent.Armed." intent.kind) level=intent.levelName}}</span>
  <button type="button" class="icon" data-action="cancelIntent" data-tooltip="{{localize 'FLOORER.Common.Cancel'}}"><i class="fas fa-xmark"></i></button>
</div>
{{/if}}

<ol class="floorer-levels">
{{#each rows}}
  <li class="level {{#if active}}active{{/if}} {{#if managed}}managed{{else}}unmanaged{{/if}}" data-level-id="{{id}}">
    <div class="row-head">
      <span class="caret" data-action="activate" data-level-id="{{id}}"><i class="fas {{#if active}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i></span>
      {{#if editingBand}}
      <span class="band-editor" data-level-id="{{id}}">
        <input type="number" name="band-bottom" value="{{bandBottom}}" placeholder="−∞" step="any" data-tooltip="{{localize 'FLOORER.Panel.BandBottom'}}">
        <span class="sep">–</span>
        <input type="number" name="band-top" value="{{bandTop}}" placeholder="∞" step="any" data-tooltip="{{localize 'FLOORER.Panel.BandTop'}}">
        <button type="button" class="icon confirm" data-action="commitBand" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.CommitBand'}}"><i class="fas fa-check"></i></button>
        <button type="button" class="icon" data-action="cancelBand" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Common.Cancel'}}"><i class="fas fa-xmark"></i></button>
      </span>
      {{else}}
      <span class="rail {{#if managed}}editable{{/if}}" {{#if managed}}data-action="editBand" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.EditBand'}}"{{/if}}>{{band}}</span>
      {{/if}}
      <span class="name" data-action="activate" data-level-id="{{id}}" data-name="{{name}}">{{name}}</span>
      {{#if managed}}<button type="button" class="icon rename" data-action="rename" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Rename'}}"><i class="fas fa-pen"></i></button>{{/if}}
      <span class="spacer"></span>
      <span class="chips">
        {{#if hasSurface}}<span class="chip success" data-tooltip="{{localize 'FLOORER.Panel.HasSurface'}}"><i class="fas fa-check"></i></span>{{else}}<span class="chip muted" data-tooltip="{{localize 'FLOORER.Panel.NoSurface'}}"><i class="fas fa-xmark"></i></span>{{/if}}
        {{#if holeCount}}<button type="button" class="chip {{#if expandedHoles}}active{{/if}}" data-action="toggleHoles" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.HoleSummary' holes=holeCount openings=openingCount}}"><i class="fas fa-circle-minus"></i>{{holeCount}}</button>{{/if}}
        {{#if stairCount}}<button type="button" class="chip {{#if expandedStairs}}active{{/if}}" data-action="toggleStairs" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.StairSummary' count=stairCount links=stairLinks}}"><i class="fas fa-stairs"></i>{{stairCount}}</button>{{/if}}
        {{#if managed}}{{#if sealed}}<button type="button" class="chip info" data-action="toggleSeal" data-level-id="{{id}}" data-sealed="true" data-tooltip="{{localize 'FLOORER.Panel.SealTooltip'}}"><i class="fas fa-lock"></i></button>{{else}}<button type="button" class="chip muted" data-action="toggleSeal" data-level-id="{{id}}" data-sealed="false" data-tooltip="{{localize 'FLOORER.Panel.UnsealTooltip'}}"><i class="fas fa-lock-open"></i></button>{{/if}}{{/if}}
        {{#unless managed}}<button type="button" class="chip dashed" data-action="adopt" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.AdoptHint'}}"><i class="fas fa-hand"></i>{{localize "FLOORER.Panel.Adopt"}}</button><button type="button" class="icon danger" data-action="removeLevel" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.RemoveLevelTip'}}"><i class="fas fa-trash"></i></button>{{/unless}}
      </span>
    </div>
    {{#if editingBand}}<p class="error band-error" hidden>{{localize "FLOORER.Panel.BandInvalid"}}</p>{{/if}}
    {{#if details}}
    <ul class="row-details">
      {{#each details.items}}
      <li class="detail-row" {{#if (eq ../details.kind "stairs")}}data-region-id="{{id}}"{{/if}}>
        {{#if (eq ../details.kind "stairs")}}
        <span class="swatch" data-color="{{color}}"></span>
        <span class="code">{{code}}</span>
        <span class="label">&#x2194;</span>
        <select class="target" data-action="retargetStair" data-region-id="{{id}}" data-level-id="{{../id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.StairTargetEdit'}}">
          {{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
        <button type="button" class="icon" data-action="jumpStair" data-region-id="{{id}}" data-level-id="{{otherLevelId}}" data-tooltip="{{jumpTooltip}}"><i class="fas fa-arrow-right-to-bracket"></i></button>
        <span class="shape">{{shape}}</span>
        <button type="button" class="icon" data-action="locateRegion" data-region-id="{{id}}" data-level-id="{{../id}}" data-tooltip="{{localize 'FLOORER.Panel.Locate'}}"><i class="fas fa-crosshairs"></i></button>
        <button type="button" class="icon danger" data-action="deleteStair" data-region-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Delete'}}"><i class="fas fa-trash"></i></button>
        {{else}}
        <span class="label">{{localize "FLOORER.Panel.HoleN" n=n}}</span>
        <span class="shape">{{shape}}</span>
        <button type="button" class="icon" data-action="locateHole" data-level-id="{{../id}}" data-hole-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Locate'}}"><i class="fas fa-crosshairs"></i></button>
        <button type="button" class="icon danger" data-action="deleteHole" data-level-id="{{../id}}" data-hole-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Delete'}}"><i class="fas fa-trash"></i></button>
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if active}}{{#if managed}}
    <div class="row-tools">
      <div class="group">
        <span class="group-label" data-tooltip="{{localize 'FLOORER.Panel.Tip.Footprint'}}">{{localize "FLOORER.Panel.Footprint"}}</span>
        <button type="button" class="icon" data-action="drawFootprint" data-tool="polygon" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.FootprintPolygon'}}"><i class="fas fa-draw-polygon"></i></button>
        <button type="button" class="icon" data-action="drawFootprint" data-tool="rectangle" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.FootprintRect'}}"><i class="fas fa-vector-square"></i></button>
        <button type="button" class="icon" data-action="drawFootprint" data-tool="ellipse" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.FootprintEllipse'}}"><i class="fas fa-circle"></i></button>
        <button type="button" class="icon" data-action="wholeScene" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.FootprintWhole'}}"><i class="fas fa-expand"></i></button>
      </div>
      <div class="group">
        <span class="group-label" data-tooltip="{{localize 'FLOORER.Panel.Tip.Hole'}}">{{localize "FLOORER.Panel.Hole"}}</span>
        <button type="button" class="icon" data-action="drawHole" data-tool="polygon" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.HolePolygon'}}"><i class="fas fa-draw-polygon"></i></button>
        <button type="button" class="icon" data-action="drawHole" data-tool="rectangle" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.HoleRect'}}"><i class="fas fa-vector-square"></i></button>
        <button type="button" class="icon" data-action="drawHole" data-tool="ellipse" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.HoleEllipse'}}"><i class="fas fa-circle"></i></button>
      </div>
      <div class="group">
        <span class="group-label" data-tooltip="{{localize 'FLOORER.Panel.Tip.Stair'}}">{{localize "FLOORER.Panel.Stair"}}</span>
        <select name="target-{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.StairTarget'}}">
          {{#each targets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
        <button type="button" class="icon" data-action="drawStair" data-tool="polygon" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.StairPolygon'}}"><i class="fas fa-draw-polygon"></i></button>
        <button type="button" class="icon" data-action="drawStair" data-tool="rectangle" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.StairRect'}}"><i class="fas fa-vector-square"></i></button>
        <button type="button" class="icon" data-action="drawStair" data-tool="ellipse" data-level-id="{{id}}" data-tooltip="{{localize 'FLOORER.Panel.Tip.StairEllipse'}}"><i class="fas fa-circle"></i></button>
      </div>
    </div>
    {{/if}}{{/if}}
    {{#if issues.length}}
    <div class="row-issues">
      {{#each issues}}
      <span class="chip issue {{severity}}" data-tooltip="{{localize label levels=levels}}">
        {{#if (eq severity "info")}}<i class="fas fa-circle-info"></i>{{else}}<i class="fas fa-triangle-exclamation"></i>{{/if}}{{localize label levels=levels}}
        {{#if fixable}}<button type="button" class="icon fix" data-action="fix" data-issue-key="{{key}}" data-tooltip="{{localize 'FLOORER.Panel.Fix'}}"><i class="fas fa-wand-magic-sparkles"></i></button>{{/if}}
      </span>
      {{/each}}
    </div>
    {{/if}}
  </li>
{{/each}}
</ol>

<footer class="floorer-foot">
  {{#if issueCount}}
    <span class="status warning"><i class="fas fa-triangle-exclamation"></i>{{localize "FLOORER.Panel.IssueCount" count=issueCount}}</span>
  {{else}}
    <span class="status success"><i class="fas fa-circle"></i>{{localize "FLOORER.Panel.NoIssues"}}</span>
  {{/if}}
  {{#if autoFixCount}}
    <button type="button" class="fix-all" data-action="fixAll"><i class="fas fa-wand-magic-sparkles"></i>{{localize "FLOORER.Panel.FixAll"}}<span class="count">{{autoFixCount}}</span></button>
  {{/if}}
</footer>
</section>
